{
  "name": "tab-once",
  "version": "1.1.1",
  "private": true,
  "license": "MIT",
  "description": "Focus an existing matching browser tab instead of opening a duplicate.",
  "packageManager": "aube@1.29.1",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "esbuild": "0.28.1",
    "jszip": "3.10.1",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  },
  "aube": {
    "allowBuilds": {
      "esbuild": true
    }
  }
}
